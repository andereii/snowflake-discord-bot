# --- Bot de Discord ---
# Token del bot (Discord Developer Portal -> Bot -> Reset Token).
# NUNCA subas este archivo a git: .env está en .gitignore.
DISCORD_TOKEN=pega_tu_token_aqui

# --- Opcional: cookies para yt-dlp ---
# Ruta a un archivo cookies.txt exportado desde tu navegador (extensión "Get cookies.txt").
# Ayuda a descargar contenido de Instagram/YouTube que requiere sesión.
# Déjalo vacío si no lo necesitas.
# YT_COOKIES_FILE=/home/alex/cookies.txt

# --- Chatbot IA ---
# Claves de API para los proveedores de IA. El bot usará el primero disponible
# (DeepSeek tiene prioridad, luego Gemini). Puedes forzar uno con AI_PROVIDER.
# Sin al menos una clave, las funciones de IA no estarán disponibles.
DEEPSEEK_API_KEY=pega_tu_clave_de_deepseek_aqui
GEMINI_API_KEY=pega_tu_clave_de_gemini_aqui

# Opcional: sobreescribe los modelos configurados en appsettings.json.
# DEEPSEEK_MODEL=deepseek-v4-flash
# GEMINI_MODEL=gemini-2.0-flash

# Opcional: fuerza el proveedor de IA ("deepseek" o "gemini"). Si no se establece,
# el bot usa el primero con clave disponible (prioridad: DeepSeek → Gemini).
# AI_PROVIDER=deepseek
