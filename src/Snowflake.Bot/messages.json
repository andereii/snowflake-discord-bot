{
  // ==========================================================================
  //  MENSAJES DEL BOT — edítalos a tu gusto, sin tocar el código.
  //
  //  · Los placeholders {llaves} se sustituyen en tiempo de ejecución.
  //    Cada mensaje indica (en su uso en el código) qué placeholders admite.
  //    Los más comunes: {usuario} {servidor} {motivo} {duracion} {caso}
  //    {latencia} {canal} {bot} {accion} {moderador} {fecha} {tipo} {texto}
  //  · Si borras una clave por accidente, el bot mostrará
  //    "Mensaje no encontrado: <clave>" en su lugar.
  //  · Los cambios en ESTE archivo (el de src/) se aplican al recompilar.
  //    El messages.json copiado junto al ejecutable se recarga en caliente.
  //  · OJO: los nombres y descripciones de los comandos (lo que ves al
  //    escribir "/" en Discord) NO están aquí: Discord exige definirlos
  //    en el código al registrarlos.
  // ==========================================================================

  "Ping": {
    // {latencia}
    "Respuesta": "🏓 Pong! Latencia con Discord: {latencia} ms"
  },

  "Errores": {
    "SinPermisos": "🚫 No tienes permisos para usar este comando (o al bot le falta algún permiso).",
    // Mensaje genérico (en producción, Bot.Debug = false)
    "Interno": "❌ Ocurrió un error inesperado ejecutando el comando.",
    // {mensaje} = mensaje de la excepción (solo si Bot.Debug = true)
    "InternoDebug": "❌ Ocurrió un error: {mensaje}"
  },

  "Presentacion": {
    // Mensaje que envía el bot al entrar por primera vez a un servidor.
